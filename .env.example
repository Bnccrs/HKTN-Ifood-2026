# Copie este arquivo para ".env" para usar (opcional).

# Motor de transcrição: "google" (padrão, gratuito, sem chave) ou "openai" (Whisper, mais preciso)
STT_ENGINE=google
# Só se STT_ENGINE=openai (instale também: pip install openai)
OPENAI_API_KEY=

# Agente usado pelo site: "gemini" (Gemini CLI + iFood MCP, usa GEMINI.md e .gemini/settings.json)
# ou vazio para o agente simulado local (agent/mock.py).
AGENT_ENGINE=gemini
# Credenciais OAuth do iFood MCP (lidas por .gemini/settings.json). Nunca commitar os valores.
IFOOD_MCP_CLIENT_ID=
IFOOD_MCP_CLIENT_SECRET=
# Opcionais do Gemini CLI: modelo, timeout por mensagem (s) e caminho do executável.
GEMINI_MODEL=
GEMINI_TIMEOUT=180
GEMINI_BIN=

# Se preenchido, tem prioridade: o app faz POST {AGENT_API_URL}/chat (ex.: http://localhost:8000)
AGENT_API_URL=
